# Copy to .env for local development. Never commit real secrets.
ENVIRONMENT=development
DATABASE_URL=sqlite:///./mediquery.db
JWT_SECRET=replace-with-a-unique-local-secret-at-least-32-characters
CORS_ORIGINS=http://localhost:8501,http://localhost:3000
UPLOAD_ROOT=private_uploads
MAX_REPORT_BYTES=10485760
MAX_PDF_PAGES=100
FREE_REPORT_LIMIT=3
# Optional: provider-hosted checkout URL. Leave empty until a real payment provider is configured.
BILLING_CHECKOUT_URL=
# Optional: protects /health/metrics. Use a random >=32-character secret in production.
METRICS_TOKEN=
